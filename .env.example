# Claude Code - Global Environment Variables
# Location: ~/.claude/.env
# Setup: Copy to ~/.claude/.env and fill in your values

# ============================================
# Context7 API (optional - for docs-seeker skill)
# ============================================
# Get your API key from https://context7.com/dashboard/api-keys
CONTEXT7_API_KEY=

# ============================================
# Telegram Notifications (optional)
# ============================================
# Sends a notification when Claude Code finishes a task.
#
# Setup:
#   1. Open Telegram, search @BotFather, send /newbot
#   2. Copy the bot token below
#   3. Send any message to your bot, then visit:
#      https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates
#   4. Copy the chat_id from the response
#
# Test: ~/.claude/scripts/notify-telegram.sh "test message"
#
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
